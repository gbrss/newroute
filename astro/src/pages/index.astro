---
// /astro/src/pages/index.astro (Home Page Oficial)
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

// Interactive React Islands
import { TestimonialsSection } from '../../src/components/TestimonialsSection';
import { ContactForm } from '../../src/components/ContactForm';
import { FloatingWhatsApp } from '../../src/components/FloatingWhatsApp';
---

<Layout title="New Route Chile | Traslados Privados, Aeropuerto y Turismo Receptivo 24/7">
  <!-- Hero Section Estático (0 KB JavaScript) -->
  <Hero />

  <!-- Teaser hacia Páginas Individuales -->
  <section class="py-16 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Card a Nuestra Empresa -->
        <div class="p-8 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col justify-between space-y-4 hover:border-amber-400 transition-colors">
          <div>
            <span class="text-xs font-semibold text-amber-700 uppercase tracking-wider block mb-1">
              Conoce Quiénes Somos
            </span>
            <h3 class="text-2xl font-bold font-display text-stone-900">
              Nuestra Empresa & Trayectoria (2006)
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 mt-2 leading-relaxed">
              Equipo de más de 20 especialistas vinculados a la hotelería y turismo con más de 18 años de trayectoria ininterrumpida y convenios preferenciales 5 estrellas.
            </p>
          </div>
          <a
            href="/empresa"
            class="inline-flex items-center gap-2 text-xs font-bold text-amber-800 hover:text-amber-950 font-display pt-2"
          >
            <span>Ir a la página de Nuestra Empresa &rarr;</span>
          </a>
        </div>

        <!-- Card a Servicios & Tarifas -->
        <div class="p-8 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col justify-between space-y-4 hover:border-amber-400 transition-colors">
          <div>
            <span class="text-xs font-semibold text-amber-700 uppercase tracking-wider block mb-1">
              Tarifario Oficial 2026
            </span>
            <h3 class="text-2xl font-bold font-display text-stone-900">
              Servicios Turísticos & Tarifas
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 mt-2 leading-relaxed">
              Consulta valores fijados en pesos chilenos para traslados al Aeropuerto SCL, Rutas del Vino (Casablanca, Maipo, Colchagua), centros de esquí y termas.
            </p>
          </div>
          <a
            href="/servicios"
            class="inline-flex items-center gap-2 text-xs font-bold text-amber-800 hover:text-amber-950 font-display pt-2"
          >
            <span>Ver Tarifario Completo Oficial &rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonios e Islas Interactivas -->
  <TestimonialsSection client:visible />
  <ContactForm client:visible />

  <!-- WhatsApp Flotante -->
  <FloatingWhatsApp client:idle />
</Layout>
