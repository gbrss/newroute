---
// src/components/astro/CompanyCTA.astro
import { COMPANY_INFO } from '../../data/newrouteData';
---

<section class="py-20 bg-stone-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
    
    <h2 class="text-3xl sm:text-4xl font-bold font-display text-stone-900 tracking-tight">
      ¿Deseas cotizar un traslado o tour para tu viaje o empresa?
    </h2>
    
    <p class="text-stone-600 text-sm sm:text-base font-light max-w-2xl mx-auto">
      Atendemos requerimientos individuales, comitivas internacionales y delegaciones de congresos las 24 horas del día.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <!-- Botón que abre el Modal de React -->
      <button
        id="cta-booking-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-md"
      >
        Reservar Traslado Online
      </button>

      <!-- Botón de WhatsApp -->
      <a
        href={`https://wa.me/${COMPANY_INFO.whatsappRaw}?text=${encodeURIComponent('Hola New Route Chile, deseo cotizar un traslado o tour.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-white font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-md"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="w-4 h-4"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Contactar Operaciones 24/7
      </a>
    </div>

  </div>
</section>

<script>
  // Conecta el botón con el modal de React
  const ctaBtn = document.getElementById('cta-booking-btn');
  if (ctaBtn) {
    ctaBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-booking-modal'));
    });
  }
</script>