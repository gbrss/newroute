---
// src/components/astro/ContactForm.astro
// Componente 100% Astro puro con validación nativa y fallback
import { COMPANY_INFO } from '../../data/newrouteData';
---

<section id="contacto" class="py-20 lg:py-28 bg-stone-100/60 border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Info Col -->
      <div class="lg:col-span-5 space-y-6">
        <div class="flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-amber-700">
          <span>💬 Contacto Directo 24/7</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold font-display text-stone-900 tracking-tight">
          Estamos a tu Servicio en Todo Momento
        </h2>

        <p class="text-stone-600 text-sm leading-relaxed font-light">
          Ponte en contacto con nuestra central de operaciones para coordinar traslados ejecutivos, cotizar flotas para congresos o resolver dudas sobre itinerarios turísticos.
        </p>

        <div class="space-y-4 pt-2 text-xs">
          <div class="p-4 rounded-xl bg-white border border-stone-200 shadow-sm flex items-start gap-3">
            <span class="text-lg">📍</span>
            <div>
              <strong class="text-stone-900 block text-sm">Oficina Central</strong>
              <span class="text-stone-600">{COMPANY_INFO.address}</span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-white border border-stone-200 shadow-sm flex items-start gap-3">
            <span class="text-lg">📞</span>
            <div>
              <strong class="text-stone-900 block text-sm">Teléfono 24 Horas</strong>
              <a href={`tel:${COMPANY_INFO.phoneRaw}`} class="text-amber-800 font-semibold">{COMPANY_INFO.phone}</a>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-white border border-stone-200 shadow-sm flex items-start gap-3">
            <span class="text-lg">📧</span>
            <div>
              <strong class="text-stone-900 block text-sm">Correo Electrónico</strong>
              <a href={`mailto:${COMPANY_INFO.email}`} class="text-stone-600">{COMPANY_INFO.email}</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Col -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl border border-stone-200 p-8 shadow-md">
          <h3 class="text-2xl font-bold font-display text-stone-900 mb-1">Envíanos un Mensaje</h3>
          <p class="text-xs text-stone-500 mb-6">Te responderemos a la brevedad por correo o WhatsApp.</p>

          <form id="contact-astro-form" class="space-y-4 text-xs">
            <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 font-medium">
              ✅ ¡Mensaje enviado con éxito! Tu consulta fue registrada en la central de New Route.
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-stone-700 mb-1">Nombre y Apellido *</label>
                <input type="text" id="c-name" required placeholder="Tu nombre" class="w-full bg-stone-50 border border-stone-300 rounded-lg p-2.5 text-xs text-stone-900" />
              </div>
              <div>
                <label class="block font-medium text-stone-700 mb-1">Correo Electrónico *</label>
                <input type="email" id="c-email" required placeholder="email@ejemplo.com" class="w-full bg-stone-50 border border-stone-300 rounded-lg p-2.5 text-xs text-stone-900" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-stone-700 mb-1">Teléfono / WhatsApp</label>
                <input type="tel" id="c-phone" placeholder="+56 9 ..." class="w-full bg-stone-50 border border-stone-300 rounded-lg p-2.5 text-xs text-stone-900" />
              </div>
              <div>
                <label class="block font-medium text-stone-700 mb-1">Asunto</label>
                <input type="text" id="c-subject" placeholder="Consulta general" class="w-full bg-stone-50 border border-stone-300 rounded-lg p-2.5 text-xs text-stone-900" />
              </div>
            </div>

            <div>
              <label class="block font-medium text-stone-700 mb-1">Mensaje o Requerimiento *</label>
              <textarea id="c-message" required rows="4" placeholder="Indícanos fechas estimadas, pasajeros, destinos..." class="w-full bg-stone-50 border border-stone-300 rounded-lg p-2.5 text-xs text-stone-900"></textarea>
            </div>

            <button type="submit" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-stone-900 hover:bg-amber-600 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer">
              Enviar Mensaje &rarr;
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Almacenamiento local directo y feedback visual
  const form = document.getElementById('contact-astro-form') as HTMLFormElement;
  const successBox = document.getElementById('form-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('c-name') as HTMLInputElement).value;
      const email = (document.getElementById('c-email') as HTMLInputElement).value;
      const phone = (document.getElementById('c-phone') as HTMLInputElement).value;
      const subject = (document.getElementById('c-subject') as HTMLInputElement).value;
      const message = (document.getElementById('c-message') as HTMLTextAreaElement).value;

      try {
        const stored = JSON.parse(localStorage.getItem('newroute_contacts_v1') || '[]');
        stored.unshift({
          id: 'c-' + Date.now(),
          createdAt: new Date().toISOString(),
          name,
          email,
          phone,
          subject: subject || 'Consulta desde sitio web Astro',
          message,
          read: false,
          replied: false,
        });
        localStorage.setItem('newroute_contacts_v1', JSON.stringify(stored));
      } catch (err) {
        console.error(err);
      }

      form.reset();
      successBox.classList.remove('hidden');
    });
  }
</script>
