---
// src/components/astro/ContactForm.astro
import { COMPANY_INFO } from '../../data/newrouteData';
---

<section id="contacto" class="py-20 lg:py-28 bg-stone-100/60 border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Columna Izquierda: Información de Contacto -->
      <div class="lg:col-span-5 space-y-6">
        <div class="flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-amber-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          <span>Contacto Directo 24/7</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold font-display text-stone-900 tracking-tight">
          Estamos a tu Servicio en Todo Momento
        </h2>

        <p class="text-stone-600 text-sm leading-relaxed font-light">
          Ponte en contacto con nuestro equipo de operaciones para coordinar traslados ejecutivos, cotizar flotas para congresos o resolver cualquier duda sobre itinerarios turísticos.
        </p>

        <div class="space-y-3 pt-2 text-xs">
          <!-- Tarjeta 1: Oficina Central -->
          <div class="p-4 rounded-xl bg-white border border-stone-200 shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-amber-600"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <span class="text-[10px] font-semibold text-stone-500 uppercase tracking-wider block mb-0.5">Oficina Central</span>
              <strong class="text-stone-900 block text-sm leading-tight">Ahumada 236, Oficina 510, Santiago Centro, Región Metropolitana, Chile</strong>
              <span class="text-stone-500 text-[11px] mt-1 block">Santiago Centro, Región Metropolitana</span>
            </div>
          </div>

          <!-- Tarjeta 2: Teléfonos -->
          <div class="p-4 rounded-xl bg-white border border-stone-200 shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-amber-600"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <span class="text-[10px] font-semibold text-stone-500 uppercase tracking-wider block mb-0.5">Teléfonos de Operaciones</span>
              <div class="text-stone-900 font-medium text-sm">Fijo: <a href={`tel:${COMPANY_INFO.phoneRaw}`} class="hover:text-amber-600 transition-colors">{COMPANY_INFO.phone}</a></div>
              <div class="text-emerald-700 font-semibold text-sm mt-0.5">WhatsApp: <a href={`https://wa.me/${COMPANY_INFO.whatsappRaw}`} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 transition-colors">{COMPANY_INFO.whatsapp}</a></div>
              <span class="text-stone-500 text-[11px] mt-1 block">Línea continua 24 horas del día</span>
            </div>
          </div>

          <!-- Tarjeta 3: Correo -->
          <div class="p-4 rounded-xl bg-white border border-stone-200 shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-amber-600"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <span class="text-[10px] font-semibold text-stone-500 uppercase tracking-wider block mb-0.5">Correo Electrónico</span>
              <a href={`mailto:${COMPANY_INFO.email}`} class="text-stone-900 font-semibold text-sm hover:text-amber-600 transition-colors">{COMPANY_INFO.email}</a>
              <span class="text-stone-500 text-[11px] mt-1 block">Respuesta en menos de 2 horas hábiles</span>
            </div>
          </div>

          <!-- Tarjeta 4: Horario (La que faltaba) -->
          <div class="p-4 rounded-xl bg-white border border-stone-200 shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-amber-600"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <span class="text-[10px] font-semibold text-stone-500 uppercase tracking-wider block mb-0.5">Horario de Atención</span>
              <strong class="text-stone-900 block text-sm">Continuo 24 Horas / 365 Días</strong>
              <span class="text-stone-500 text-[11px] mt-1 block">Monitoreo constante de llegadas aéreas</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Formulario -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl border border-stone-200 p-8 shadow-md">
          <div class="text-xs font-semibold tracking-wider uppercase text-amber-700 mb-2">
            Formulario de Contacto & Consultas
          </div>
          <h3 class="text-2xl font-bold font-display text-stone-900 mb-1">Envíanos un Mensaje</h3>
          <p class="text-xs text-stone-500 mb-6">Escríbenos para consultas de tarifas a medida o traslados especiales.</p>

          <form id="contact-astro-form" class="space-y-4 text-xs">
            <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 font-medium">
              ✅ ¡Mensaje enviado con éxito! Tu consulta fue registrada en la central de New Route.
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-stone-700 mb-1">Nombre y Apellido *</label>
                <input type="text" id="c-name" required placeholder="Tu nombre completo" class="w-full bg-stone-50 border border-stone-200 rounded-lg p-2.5 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:border-amber-500" />
              </div>
              <div>
                <label class="block font-medium text-stone-700 mb-1">Correo Electrónico *</label>
                <input type="email" id="c-email" required placeholder="tu.correo@ejemplo.com" class="w-full bg-stone-50 border border-stone-200 rounded-lg p-2.5 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:border-amber-500" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-stone-700 mb-1">Teléfono / WhatsApp</label>
                <input type="tel" id="c-phone" placeholder="+56 9 1234 5678" class="w-full bg-stone-50 border border-stone-200 rounded-lg p-2.5 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:border-amber-500" />
              </div>
              <div>
                <label class="block font-medium text-stone-700 mb-1">Asunto</label>
                <input type="text" id="c-subject" placeholder="Ej. Cotización Van Grupal / Tour Personalizado" class="w-full bg-stone-50 border border-stone-200 rounded-lg p-2.5 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:border-amber-500" />
              </div>
            </div>

            <div>
              <label class="block font-medium text-stone-700 mb-1">Mensaje o Requerimiento *</label>
              <textarea id="c-message" required rows="4" placeholder="Indícanos fechas estimadas, número de pasajeros, destinos deseados..." class="w-full bg-stone-50 border border-stone-200 rounded-lg p-2.5 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-none focus:border-amber-500"></textarea>
            </div>

            <!-- Fila del Checkbox y Botón de Envío -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="text-stone-500 text-[11px]">Tus datos son tratados bajo estricta confidencialidad</span>
              </div>

              <button type="submit" class="w-full sm:w-auto px-5 py-2.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                <span>Enviar Mensaje</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-astro-form') as HTMLFormElement;
  const successBox = document.getElementById('form-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('c-name') as HTMLInputElement).value;
      const email = (document.getElementById('c-email') as HTMLInputElement).value;
      const phone = (document.getElementById('c-phone') as HTMLInputElement).value;
      const subject = (document.getElementById('c-subject') as HTMLInputElement).value;
      const message = (document.getElementById('c-message') as HTMLTextAreaElement).value;

      try {
        const stored = JSON.parse(localStorage.getItem('newroute_contacts_v1') || '[]');
        stored.unshift({
          id: 'c-' + Date.now(),
          createdAt: new Date().toISOString(),
          name, email, phone,
          subject: subject || 'Consulta desde sitio web Astro',
          message,
          read: false,
          replied: false,
        });
        localStorage.setItem('newroute_contacts_v1', JSON.stringify(stored));
      } catch (err) {
        console.error(err);
      }

      form.reset();
      successBox.classList.remove('hidden');
    });
  }
</script>