---
// src/components/astro/Footer.astro
import { COMPANY_INFO } from '../../data/newrouteData';
import logoImg from '../../assets/images/logo.png';
---

<footer class="bg-[#0a0a0a] text-stone-400 border-t border-stone-800 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      
      <!-- Brand & History -->
      <div class="lg:col-span-5 space-y-5">
        <!-- Bloque del Logo idéntico al original -->
        <div class="flex items-center gap-3">
          <img src={logoImg.src} alt="New Route Chile Logo" class="h-18 w-auto object-contain" /> 
        </div>

        <p class="text-stone-400 text-xs leading-relaxed max-w-sm">
          Fundada en 2006. Casi dos décadas entregando soluciones de transporte privado, convenios hoteleros, excursiones a valles vitivinícolas y centros de esquí con los más altos estándares de calidad y seguridad.
        </p>

        <div class="pt-2">
          <!-- 1. Agregamos el ID al botón -->
          <button
            id="footer-booking-btn"
            class="inline-block px-5 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs transition-colors cursor-pointer"
          >
            Solicitar Reserva 24/7
          </button>
        </div>
      </div>

      <!-- Contact Details -->
      <div class="lg:col-span-4 space-y-4">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Datos de Contacto Central
        </div>

        <ul class="space-y-3 text-stone-400 text-xs">
          <li class="flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-500 shrink-0 mt-0.5"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{COMPANY_INFO.address}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-500 shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${COMPANY_INFO.phoneRaw}`} class="hover:text-amber-400 transition-colors">
              {COMPANY_INFO.phone}
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-500 shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href={`mailto:${COMPANY_INFO.email}`} class="hover:text-amber-400 transition-colors">
              {COMPANY_INFO.email}
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-500 shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{COMPANY_INFO.schedule}</span>
          </li>
        </ul>
      </div>

      <!-- Pages & Navigation Links -->
      <div class="lg:col-span-3 space-y-4">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Páginas del Sitio
        </div>
        <ul class="space-y-2.5 text-xs text-stone-400">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Página de Inicio</a></li>
          <li><a href="/empresa" class="hover:text-amber-400 transition-colors">Nuestra Empresa (Historia 2006 & Flota)</a></li>
          <li><a href="/servicios" class="hover:text-amber-400 transition-colors">Servicios & Tarifas Oficiales 2026</a></li>
          <li><a href="/#testimonios" class="hover:text-amber-400 transition-colors">Testimonios & Reseñas</a></li>
          <li><a href="/#contacto" class="hover:text-amber-400 transition-colors">Contacto & Ubicación Ahumada 236</a></li>
        </ul>
      </div>
    </div>

    <!-- Micro Copyright with Gear Icon to Gerencia -->
    <div class="mt-12 pt-6 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-stone-500 text-[11px]">
      <div>
        © 2006–2026 New Route Chile SpA. Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-4">
        <a href="#top" class="hover:text-stone-300 transition-colors">Subir al Inicio ↑</a>
        <span class="text-stone-700">·</span>
        <a
          href="/gerencia"
          class="flex items-center gap-1.5 text-stone-500 hover:text-amber-400 transition-colors group"
          title="Portal de Acceso a Gerencia & Operaciones"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 group-hover:rotate-45 transition-transform"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          <span>Acceso Gerencia</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  // 2. Script para abrir el modal al hacer clic en el botón del Footer
  const footerBookingBtn = document.getElementById('footer-booking-btn');
  if (footerBookingBtn) {
    footerBookingBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-booking-modal'));
    });
  }
</script>