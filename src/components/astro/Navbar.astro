---
// src/components/astro/Navbar.astro
import logo from '../../assets/images/logo.png';

interface Props {
  currentPage?: 'home' | 'empresa' | 'servicios' | 'gerencia';
}
const { currentPage = 'home' } = Astro.props;
---

<header class="sticky top-0 z-40 bg-stone-900/95 backdrop-blur-md border-b border-stone-800 text-stone-100">
  <!-- Top micro bar -->
  <div class="hidden lg:block bg-stone-950/80 border-b border-stone-800/60 py-1.5 px-4 text-xs text-stone-400">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5 text-stone-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-amber-500"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Servicio continuado 24 Horas / 365 Días</span>
        </span>
        <span class="text-stone-700">·</span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-stone-500"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Ahumada 236, Of. 510, Santiago Centro</span>
        </span>
        <span class="text-stone-700">·</span>
        <span class="text-stone-300 font-medium">Convenio Preferente Hotelería 5★</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="tel:+56223942153" class="flex items-center gap-1.5 text-stone-300 hover:text-amber-400 font-medium transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-amber-500"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>+56 2 2394 2153</span>
        </a>
        <span class="text-stone-700">·</span>
        <span class="text-amber-400 font-semibold flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" />
          <span>Chile</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img src={logo.src} alt="New Route Chile" class="h-18 w-auto object-contain transition-transform group-hover:scale-105" />
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="/" class:list={["py-1 transition-colors", currentPage === 'home' ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-stone-300 hover:text-amber-400"]}>
        Inicio
      </a>
      <a href="/empresa" class:list={["py-1 transition-colors", currentPage === 'empresa' ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-stone-300 hover:text-amber-400"]}>
        Nuestra Empresa
      </a>
      <a href="/servicios" class:list={["py-1 transition-colors", currentPage === 'servicios' ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-stone-300 hover:text-amber-400"]}>
        Servicios & Tarifas
      </a>
      <a href="/#testimonios" class="text-stone-300 hover:text-amber-400 transition-colors py-1">
        Testimonios
      </a>
      <a href="/#contacto" class="text-stone-300 hover:text-amber-400 transition-colors py-1">
        Contacto
      </a>
    </nav>

    <div class="hidden sm:flex items-center gap-3">
      <button
        id="open-booking-btn"
        class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-semibold text-sm shadow-md shadow-amber-500/20 transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-stone-950"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
        <span>Gestionar Reserva</span>
      </button>
    </div>

    <div class="flex md:hidden items-center gap-2">
      <button id="mobile-menu-btn" class="p-2 rounded-lg text-stone-300 hover:bg-stone-800" aria-label="Abrir menú">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-stone-950 border-b border-stone-800 px-4 pt-3 pb-6 space-y-3">
    <div class="space-y-2 text-stone-300 font-medium">
      <a href="/" class="block py-2 px-3 rounded hover:bg-stone-800">Inicio</a>
      <a href="/empresa" class="block py-2 px-3 rounded hover:bg-stone-800">Nuestra Empresa</a>
      <a href="/servicios" class="block py-2 px-3 rounded hover:bg-stone-800">Servicios & Tarifas</a>
      <a href="/#testimonios" class="block py-2 px-3 rounded hover:bg-stone-800">Testimonios</a>
      <a href="/#contacto" class="block py-2 px-3 rounded hover:bg-stone-800">Contacto</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => menu.classList.toggle('hidden'));
  }

  const bookingBtn = document.getElementById('open-booking-btn');
  if (bookingBtn) {
    bookingBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-booking-modal'));
    });
  }
</script>