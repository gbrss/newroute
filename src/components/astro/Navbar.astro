---
// src/components/astro/Navbar.astro
// Componente 100% Astro puro con script ligero para menú móvil
interface Props {
  currentPage?: 'home' | 'empresa' | 'servicios' | 'gerencia';
}

const { currentPage = 'home' } = Astro.props;
---

<header class="sticky top-0 z-40 bg-stone-900/95 backdrop-blur-md border-b border-stone-800 text-stone-100">
  <!-- Top micro bar -->
  <div class="hidden lg:block bg-stone-950/80 border-b border-stone-800/60 py-1.5 px-4 text-xs text-stone-400">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5 text-stone-300">
          <span>🕒 Servicio continuado 24 Horas / 365 Días</span>
        </span>
        <span class="text-stone-700">·</span>
        <span>Ahumada 236, Of. 510, Santiago Centro</span>
        <span class="text-stone-700">·</span>
        <span class="text-stone-300 font-medium">Convenio Preferente Hotelería 5★</span>
      </div>

      <div class="flex items-center gap-4">
        <a href="tel:+56223942153" class="text-stone-300 hover:text-amber-400 font-medium transition-colors">
          📞 +56 2 2394 2153
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-lg bg-amber-600 flex items-center justify-center text-stone-950 font-bold shadow-md shadow-amber-600/20 group-hover:bg-amber-500 transition-colors">
        🧭
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl font-bold tracking-tight text-white font-display">NEW ROUTE</span>
          <span class="text-xs font-semibold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">CHILE</span>
        </div>
        <p class="text-[11px] text-stone-400 font-light tracking-wide">Transporte & Turismo · Desde 2006</p>
      </div>
    </a>

    <!-- Desktop Menu Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a
        href="/"
        class:list={[
          "py-1 transition-colors",
          currentPage === 'home' ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-stone-300 hover:text-amber-400"
        ]}
      >
        Inicio
      </a>
      <a
        href="/empresa"
        class:list={[
          "py-1 transition-colors",
          currentPage === 'empresa' ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-stone-300 hover:text-amber-400"
        ]}
      >
        Nuestra Empresa
      </a>
      <a
        href="/servicios"
        class:list={[
          "py-1 transition-colors",
          currentPage === 'servicios' ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-stone-300 hover:text-amber-400"
        ]}
      >
        Servicios & Tarifas
      </a>
      <a href="/#testimonios" class="text-stone-300 hover:text-amber-400 transition-colors py-1">
        Testimonios
      </a>
      <a href="/#contacto" class="text-stone-300 hover:text-amber-400 transition-colors py-1">
        Contacto
      </a>
    </nav>

    <!-- CTA Button -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/servicios#cotizador"
        class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-semibold text-sm shadow-md shadow-amber-500/20 transition-all cursor-pointer"
      >
        <span>📅 Gestionar Reserva</span>
      </a>
    </div>

    <!-- Mobile Button -->
    <div class="flex md:hidden items-center gap-2">
      <button id="mobile-menu-btn" class="p-2 rounded-lg text-stone-300 hover:bg-stone-800" aria-label="Abrir menú">
        ☰
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-stone-950 border-b border-stone-800 px-4 pt-3 pb-6 space-y-3">
    <div class="space-y-2 text-stone-300 font-medium">
      <a href="/" class="block py-2 px-3 rounded hover:bg-stone-800">Inicio</a>
      <a href="/empresa" class="block py-2 px-3 rounded hover:bg-stone-800">Nuestra Empresa</a>
      <a href="/servicios" class="block py-2 px-3 rounded hover:bg-stone-800">Servicios & Tarifas</a>
      <a href="/#testimonios" class="block py-2 px-3 rounded hover:bg-stone-800">Testimonios</a>
      <a href="/#contacto" class="block py-2 px-3 rounded hover:bg-stone-800">Contacto</a>
    </div>
  </div>
</header>

<script>
  // Script nativo de cliente (Vanilla JS ultra liviano sin dependencias)
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
