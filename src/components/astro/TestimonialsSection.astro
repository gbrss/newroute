---
// src/components/astro/TestimonialsSection.astro
import { TESTIMONIALS } from '../../data/newrouteData';
---

<section id="testimonios" class="py-20 lg:py-28 bg-white border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-14">
      <div class="text-xs font-semibold tracking-wider uppercase text-amber-700 mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>Opiniones & Reseñas Verificadas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold font-display text-stone-900 tracking-tight">
        La Confianza de Huéspedes y Empresas
      </h2>
      <p class="text-stone-600 text-sm sm:text-base mt-2 font-light">
        Más de 18 años atendiendo a viajeros internacionales, embajadas y huéspedes de prestigiosos hoteles de Santiago.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {TESTIMONIALS.map((t) => (
        <div class="bg-stone-50 rounded-2xl p-7 border border-stone-200 hover:border-amber-400 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1 text-amber-500">
                {Array.from({ length: t.rating }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                ))}
              </div>
              <div class="text-xs text-stone-600">
                <span>{t.date}</span>
              </div>
            </div>
            <blockquote class="text-sm text-stone-800 leading-relaxed italic">
              "{t.comment}"
            </blockquote>
          </div>

          <div class="mt-6 pt-4 border-t border-stone-200/80">
            <div class="font-bold text-sm text-stone-900">{t.author}</div>
            <div class="flex flex-wrap items-center gap-1.5 text-xs text-stone-600 mt-1">
              <span>{t.roleOrOrigin}</span>
              {t.hotelOrCompany && (
                <>
                  <span>·</span>
                  <span class="text-stone-700 font-medium">{t.hotelOrCompany}</span>
                </>
              )}
              <span>·</span>
              <span class="text-amber-800 font-semibold">{t.serviceUsed}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Sección de colaboración corregida (Colores y textos originales) -->
    <div class="mt-12 bg-[#0a0a0a] rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 border border-stone-800">
      <div class="flex items-center gap-5">
        <div class="w-14 h-14 rounded-xl bg-[#2a1f0f] flex items-center justify-center text-[#d4a34b] font-bold text-xl shrink-0 border border-[#4a3416]">
          5★
        </div>
        <div>
          <h3 class="text-lg font-bold font-display text-white">Colaboración Oficial con Hotelería de Santiago</h3>
          <p class="text-xs text-stone-400 mt-1">Convenio de tarifas preferentes y atención prioritaria para conserjerías y huéspedes del Hotel InterContinental Santiago.</p>
        </div>
      </div>
      <div class="shrink-0 text-xs text-stone-400 font-medium pr-4">
        Facturación electrónica para empresas
      </div>
    </div>
  </div>
</section>