---
// src/pages/gerencia.astro
import Layout from '../layouts/Layout.astro';
import { GerenciaPage as GerenciaView } from '../components/views/GerenciaView';
import { INITIAL_BOOKINGS_SEED, INITIAL_CONTACT_SEED, SERVICES_TARIFFS } from '../data/newrouteData';
---

<Layout
  title="Portal de Gerencia | New Route Chile"
  description="Portal de despacho y administración interna de operaciones."
>
  <GerenciaView
    client:only="react"
    bookings={INITIAL_BOOKINGS_SEED}
    contacts={INITIAL_CONTACT_SEED}
    tariffs={SERVICES_TARIFFS}
  />
</Layout>