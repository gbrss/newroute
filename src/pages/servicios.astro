---
// src/pages/servicios.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
// IMPORTAMOS EL COMPONENTE DE REACT
import { ServicesAndRates } from '../components/ServicesAndRates'; 
---

<Layout
  title="Servicios & Tarifas Oficiales 2026 | New Route Chile"
  description="Tarifario oficial en pesos chilenos para traslados aeropuerto SCL, rutas del vino, centros de esquí y turismo privado."
>
  <Navbar currentPage="servicios" />

  <!-- Encabezado -->
  <header class="bg-stone-900 text-white py-14 border-b border-stone-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-stone-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2 text-stone-600">/</span>
        <span class="text-amber-400">Servicios & Tarifas Oficiales</span>
      </nav>
      
      <div class="text-xs font-semibold tracking-wider uppercase text-amber-500 mb-2">
        Tarifario Oficial 2026 · New Route Chile
      </div>
      
      <h1 class="text-4xl sm:text-5xl font-bold font-display text-white">Servicios Turísticos & Tarifas</h1>
      
      <p class="text-stone-300 mt-4 max-w-3xl font-light leading-relaxed">
        Consulta los valores oficiales en pesos chilenos (CLP) para traslados al Aeropuerto SCL, rutas del vino, centros de esquí en los Andes, termas naturales y tours patrimoniales.
      </p>
    </div>
  </header>

  <!-- COMPONENTE REACT DINÁMICO -->
  <ServicesAndRates client:load />

  <!-- Sección 1: Tarjetas de Beneficios -->
  <section class="py-16 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="p-6 rounded-2xl border border-stone-200 bg-stone-50">
          <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="text-sm font-bold text-stone-900 mb-2">Tarifas Fijas 24/7</h3>
          <p class="text-xs text-stone-600 leading-relaxed">Sin sobreprecios nocturnos, días festivos o aumentos de tarifa dinámica por lluvia o demanda.</p>
        </div>

        <div class="p-6 rounded-2xl border border-stone-200 bg-stone-50">
          <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="14" height="18" x="5" y="3" rx="2" ry="2"/><path d="M9 18h6"/></svg>
          </div>
          <h3 class="text-sm font-bold text-stone-900 mb-2">Equipaje Sin Cargo Extra</h3>
          <p class="text-xs text-stone-600 leading-relaxed">Capacidad garantizada para maletas de bodega, bolsos de mano y equipamiento deportivo de ski.</p>
        </div>

        <div class="p-6 rounded-2xl border border-stone-200 bg-stone-50">
          <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
          </div>
          <h3 class="text-sm font-bold text-stone-900 mb-2">Seguros de Pasajero</h3>
          <p class="text-xs text-stone-600 leading-relaxed">Pólizas con cobertura integral conforme al Decreto Supremo 80 del Ministerio de Transportes.</p>
        </div>

        <div class="p-6 rounded-2xl border border-stone-200 bg-stone-50">
          <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
          </div>
          <h3 class="text-sm font-bold text-stone-900 mb-2">Facturación & Pago Fácil</h3>
          <p class="text-xs text-stone-600 leading-relaxed">Emitimos facturas y boletas electrónicas en pesos chilenos o dólares con pago online o presencial.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Sección 2: Preguntas Frecuentes (ABIERTAS POR DEFECTO) -->
  <section class="py-20 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <div class="text-xs font-semibold tracking-wider uppercase text-amber-700 mb-2">
          Preguntas Frecuentes
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold font-display text-stone-900 tracking-tight">
          Dudas Habituales sobre Tarifas y Traslados
        </h2>
      </div>

      <div class="space-y-4">
        
        <!-- FAQ 1 -->
        <details open class="group bg-white rounded-xl border border-stone-200 p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <span class="text-sm font-bold text-stone-900">¿Qué incluye la tarifa de traslado al Aeropuerto SCL?</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-stone-400 group-open:-rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="mt-4 text-xs text-stone-600 leading-relaxed pl-7">
            Incluye recepción en el área de llegadas con letrero personalizado, asistencia con las maletas, peajes de autopista (TAG), monitoreo en tiempo real del vuelo y espera de hasta 60 minutos sin costo adicional por retrasos.
          </div>
        </details>

        <!-- FAQ 2 -->
        <details open class="group bg-white rounded-xl border border-stone-200 p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <span class="text-sm font-bold text-stone-900">¿Cuál es la diferencia entre la tarifa de 1-3 PAX y 4-6 PAX?</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-stone-400 group-open:-rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="mt-4 text-xs text-stone-600 leading-relaxed pl-7">
            Para 1 a 3 personas se asigna un Sedán Ejecutivo de confort o SUV. Para 4 a 6 personas se dispone de una Van Ejecutiva espaciosa con maletero ampliado para equipaje de gran tamaño.
          </div>
        </details>

        <!-- FAQ 3 -->
        <details open class="group bg-white rounded-xl border border-stone-200 p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <span class="text-sm font-bold text-stone-900">¿Las tarifas de las Rutas del Vino incluyen las entradas y degustaciones?</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-stone-400 group-open:-rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="mt-4 text-xs text-stone-600 leading-relaxed pl-7">
            Nuestras tarifas cubren el transporte privado exclusivo de ida y vuelta con chofer a disposición durante la jornada. Las entradas a los tours guiados de las viñas y almuerzos se coordinan y abonan directamente en las bodegas según la preferencia de cada cliente.
          </div>
        </details>

        <!-- FAQ 4 -->
        <details open class="group bg-white rounded-xl border border-stone-200 p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <span class="text-sm font-bold text-stone-900">¿Tienen conductores bilingües?</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-stone-400 group-open:-rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="mt-4 text-xs text-stone-600 leading-relaxed pl-7">
            Sí, disponemos de conductores con dominio fluido del idioma inglés. Puedes indicarlo al momento de realizar la reserva online o por WhatsApp.
          </div>
        </details>

        <!-- FAQ 5 -->
        <details open class="group bg-white rounded-xl border border-stone-200 p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <span class="text-sm font-bold text-stone-900">¿Qué medios de pago aceptan?</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-stone-400 group-open:-rotate-180 transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="mt-4 text-xs text-stone-600 leading-relaxed pl-7">
            Aceptamos transferencias bancarias locales, tarjetas de crédito/débito internacionales, efectivo en pesos chilenos (CLP) o dólares estadounidenses (USD) y facturación electrónica para empresas con RUT.
          </div>
        </details>

      </div>
    </div>
  </section>

  <Footer />
</Layout>